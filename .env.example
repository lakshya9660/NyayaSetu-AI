# NyayaSetu AI - Environment Configuration

# Application
APP_ENV=development
APP_NAME="NyayaSetu AI"
SECRET_KEY=nyayasetu-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite for simple local development:
DATABASE_URL=sqlite:///./nyayasetu.db
# PostgreSQL option (production / Docker Compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyayasetu

# AI / LLM Configuration
# If OPENAI_API_KEY is left empty, NyayaSetu operates in deterministic grounded DEMO mode with prominent UI indicators
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_RELEVANCE_THRESHOLD=0.45
RAG_MAX_CHUNKS=4

# Server & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Initial Seed Credentials (for development bootstrap)
ADMIN_EMAIL=admin@nyayasetu.org
ADMIN_PASSWORD=AdminSecureNyaya2026!
DEMO_CITIZEN_EMAIL=citizen@nyayasetu.org
DEMO_CITIZEN_PASSWORD=CitizenDemo2026!

# Upload & Rate Limits
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=30

